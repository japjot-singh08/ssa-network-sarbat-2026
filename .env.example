# Local persistence is used when DATABASE_URL is absent. Never use file mode on Vercel.
DEMO_MODE=true
DEMO_REVIEWER_PASSCODE=replace-with-a-long-private-passcode
SESSION_SECRET=replace-with-at-least-32-random-characters
# Supabase PostgreSQL transaction pooler or direct connection (server only)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Real accounts: set DEMO_MODE=false. These auth settings are accessed on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Additional approved university domains, e.g. ox.ac.uk,ubc.ca. .edu is supported by default.
UNIVERSITY_EMAIL_DOMAINS=
