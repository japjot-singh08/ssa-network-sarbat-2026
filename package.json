{
  "name": "ssa-network",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:demo": "node scripts/setup-demo.mjs",
    "demo:credentials": "node scripts/setup-demo.mjs --show",
    "seed:supabase": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test:browser": "playwright test",
    "format": "prettier --write app lib tests scripts *.ts *.mjs *.json README.md DEMO.md",
    "db:setup": "node --env-file=.env.local --import tsx scripts/configure-database.ts",
    "db:verify": "node --env-file=.env.local --import tsx scripts/verify-database.ts",
    "reset:demo": "node --env-file=.env.local --import tsx scripts/reset-demo.ts",
    "db:migrate:accounts": "node --env-file=.env.local --import tsx scripts/migrate-accounts.ts",
    "account:grant": "node --env-file=.env.local --import tsx scripts/provision-account.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@supabase/supabase-js": "^2.90.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
